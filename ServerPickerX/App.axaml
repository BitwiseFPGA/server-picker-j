<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ServerPickerX.App"
             xmlns:local="using:ServerPickerX"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
		<ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
				<!-- Locale swapping only removes dictionaries with a LanguageCode key -->
				<ResourceInclude Source="/Styles/Palette.axaml" />
				<!-- English is only the startup default. LocalizationService loads the chosen
				     language on its own, so the other eight are never loaded unless picked -->
				<ResourceInclude Source="/Locales/Locale_en-us.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/BaseStyle.axaml" />
        <StyleInclude Source="/Styles/TitleBarButtonStyle.axaml" />
        <StyleInclude Source="/Styles/MainButtonStyle.axaml" />
        <StyleInclude Source="/Styles/TextBoxStyle.axaml" />
        <StyleInclude Source="/Styles/ComboBoxStyle.axaml" />
        <StyleInclude Source="/Styles/PresetTableStyle.axaml" />
        <!-- Must stay after BaseStyle so blocked card setters win over metric tiers -->
        <StyleInclude Source="/Styles/ServerCardStyle.axaml" />
    </Application.Styles>
</Application>
