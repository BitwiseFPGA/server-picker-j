<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:userControls="using:ServerPickerX"
        xmlns:viewmodels="using:ServerPickerX.ViewModels"
        xmlns:models="using:ServerPickerX.Models"
        xmlns:converters="clr-namespace:ServerPickerX.Converters"
        mc:Ignorable="d"
        x:Class="ServerPickerX.Views.PresetManagerWindow"
        x:DataType="viewmodels:PresetManagerWindowViewModel"
        Width="996"
        Height="610"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterOwner"
        Background="Transparent">

    <Window.Resources>
        <converters:ImageConverter x:Key="ImageConverter" />
    </Window.Resources>

    <Border
        Background="{DynamicResource SpxWindowBrush}"
        BorderBrush="{DynamicResource SpxBorderBrush}"
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Border Classes="rule-bottom" Background="{DynamicResource SpxChromeBrush}">
                <Grid x:Name="TitleBar"
                      Background="Transparent"
                      PointerPressed="TitleBar_PointerPressed">
                    <TextBlock Classes="window-title"
                               Margin="12,0,0,0"
                               Text="{Binding WindowTitle}" />
                    <userControls:TitleBarButtons />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="8,8,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" MinWidth="260" MaxWidth="400"/>
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    BorderBrush="{DynamicResource SpxBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Background="{DynamicResource SpxChromeBrush}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid ColumnDefinitions="*,6,*,6,*">
                            <Button
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="main-btn"
                                Content="{DynamicResource AddPreset}"
                                ToolTip.Tip="{DynamicResource AddPresetToolTip}"
                                Click="AddBtn_Click" />
                            <Button
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="main-btn"
                                Content="{DynamicResource DeletePreset}"
                                ToolTip.Tip="{DynamicResource DeletePresetToolTip}"
                                IsEnabled="{Binding CanDelete}"
                                Click="DeleteBtn_Click" />
                            <Button
                                Grid.Column="4"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="main-btn"
                                Content="{DynamicResource ApplyPreset}"
                                ToolTip.Tip="{DynamicResource ApplyPresetToolTip}"
                                IsEnabled="{Binding CanApply}"
                                Click="ApplyBtn_Click" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,6,*" Margin="0,6,0,0">
                            <Button
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="main-btn"
                                Content="{DynamicResource PresetShare}"
                                ToolTip.Tip="{DynamicResource PresetShareToolTip}"
                                IsEnabled="{Binding CanApply}"
                                Click="ShareBtn_Click" />
                            <Button
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="main-btn"
                                Content="{DynamicResource PresetImport}"
                                ToolTip.Tip="{DynamicResource PresetImportToolTip}"
                                Click="ImportBtn_Click" />
                        </Grid>

                        <!-- A header row over a plain list. Sorting and renaming are handled in the code-behind -->
                        <Grid Grid.Row="2" Margin="0,10,0,0" RowDefinitions="Auto,*">
                            <Border Classes="preset-table-header">
                                <Border Classes="preset-table-header-cell"
                                        Tapped="PresetHeader_Tapped"
                                        DoubleTapped="PresetHeader_Tapped">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="preset-table-header-text"
                                                   Text="{DynamicResource PresetListHeader}" />
                                        <Path x:Name="PresetSortGlyph" Classes="sort-glyph" IsVisible="False" />
                                    </StackPanel>
                                </Border>
                            </Border>

                            <ListBox
                                Grid.Row="1"
                                x:Name="PresetList"
                                Classes="preset-table"
                                ItemsSource="{Binding Presets}"
                                SelectedItem="{Binding SelectedPresetItem}"
                                SelectionMode="Multiple"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionChanged="PresetList_SelectionChanged"
                                DoubleTapped="PresetList_DoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:PresetModel">
                                        <Border Classes="preset-table-row">
                                            <Panel>
                                                <TextBlock x:Name="PresetNameText"
                                                           Classes="preset-table-cell"
                                                           Text="{Binding Name}" />
                                                <TextBox x:Name="PresetNameEditor"
                                                         Classes="preset-name-editor"
                                                         IsVisible="False" />
                                            </Panel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <GridSplitter
                    Grid.Column="1"
                    ResizeDirection="Columns"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent">
                    <GridSplitter.Template>
                        <ControlTemplate>
                            <Grid Background="Transparent">
                                <Border
                                    Width="1"
                                    Margin="0,8"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource SpxBorderBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <Border
                    Grid.Column="2"
                    BorderBrush="{DynamicResource SpxBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Background="{DynamicResource SpxChromeBrush}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Classes="muted"
                                FontSize="12"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                Text="{DynamicResource PresetServersHeader}" />
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                HorizontalAlignment="Right">
                                <Button
                                    Classes="chip"
                                    Content="{DynamicResource PresetAllowAll}"
                                    ToolTip.Tip="{DynamicResource PresetAllowAllToolTip}"
                                    IsEnabled="{Binding CanEditPreset}"
                                    Click="AllowAllBtn_Click" />
                                <Button
                                    Classes="chip"
                                    Content="{DynamicResource PresetAllowNone}"
                                    ToolTip.Tip="{DynamicResource PresetAllowNoneToolTip}"
                                    IsEnabled="{Binding CanEditPreset}"
                                    Click="AllowNoneBtn_Click" />
                                <Button
                                    Classes="main-btn"
                                    Content="{Binding ClusterToggleText}"
                                    ToolTip.Tip="{DynamicResource ClusterUnclusterToolTip}"
                                    IsEnabled="{Binding CanToggleClusterMode}"
                                    Click="ClusterToggleBtn_Click" />
                            </StackPanel>
                        </Grid>

                        <!-- Header and rows share the same column widths so they line up.
                             Each header cell's Tag is the sort key the view model understands -->
                        <Grid Grid.Row="1"
                              Margin="0,10,0,0"
                              RowDefinitions="Auto,*"
                              IsEnabled="{Binding CanEditPreset}">
                            <Border Classes="preset-table-header">
                                <Grid ColumnDefinitions="100,56,96,*">
                                    <Border Grid.Column="0"
                                            Classes="preset-table-header-cell"
                                            Tag="Allowed"
                                            Tapped="ServerHeader_Tapped"
                                            DoubleTapped="ServerHeader_Tapped">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="preset-table-header-text"
                                                       Text="{DynamicResource AllowedColumnHeader}" />
                                            <Path x:Name="AllowedSortGlyph" Classes="sort-glyph" IsVisible="False" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1"
                                            Classes="preset-table-header-cell"
                                            Tag="Flag"
                                            Tapped="ServerHeader_Tapped"
                                            DoubleTapped="ServerHeader_Tapped">
                                        <Path x:Name="FlagSortGlyph" Classes="sort-glyph" IsVisible="False" />
                                    </Border>
                                    <Border Grid.Column="2"
                                            Classes="preset-table-header-cell"
                                            Tag="ServerId"
                                            Tapped="ServerHeader_Tapped"
                                            DoubleTapped="ServerHeader_Tapped">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="preset-table-header-text" Text="ID" />
                                            <Path x:Name="IdSortGlyph" Classes="sort-glyph" IsVisible="False" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3"
                                            Classes="preset-table-header-cell"
                                            Tag="ServerName"
                                            Tapped="ServerHeader_Tapped"
                                            DoubleTapped="ServerHeader_Tapped">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="preset-table-header-text" Text="Location" />
                                            <Path x:Name="LocationSortGlyph" Classes="sort-glyph" IsVisible="False" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <ListBox
                                Grid.Row="1"
                                x:Name="ServerList"
                                Classes="preset-table"
                                ItemsSource="{Binding PresetServers}"
                                SelectionMode="Multiple"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:PresetServerModel">
                                        <Border Classes="preset-table-row">
                                            <Grid ColumnDefinitions="100,56,96,*">
                                                <CheckBox
                                                    Classes="preset-toggle"
                                                    IsChecked="{Binding IsAllowed}"
                                                    Click="AllowedCheckBox_Click" />
                                                <Border Grid.Column="1"
                                                        Width="26"
                                                        Height="17"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="{DynamicResource SpxBorderBrush}"
                                                        BorderThickness="1"
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding Flag, Converter={StaticResource ImageConverter}}"
                                                           Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock Grid.Column="2"
                                                           Classes="preset-table-cell"
                                                           Text="{Binding Name}" />
                                                <TextBlock Grid.Column="3"
                                                           Classes="preset-table-cell"
                                                           Text="{Binding Description}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
